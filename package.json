{
  "name": "ghis",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve": "ng serve --open",
    "deploy": "ng build --base-href='/' && angular-cli-ghpages --dir=dist/ghislain-resume/browser --no-silent",
    "clean": "rimraf dist"
  },
  "description": "Elegant resume and CV theme with Bootstrap 5.",
  "keywords": [
    "css",
    "sass",
    "html",
    "responsive",
    "theme",
    "template"
  ],
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.12",
    "@angular/compiler": "^21.2.12",
    "@angular/core": "^21.2.12",
    "@angular/platform-browser": "^21.2.12",
    "@angular/router": "^21.2.13",
    "bootstrap": "^5.3.8",
    "rxjs": "^7.8.2",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.11",
    "angular-cli-ghpages": "^3.0.3",
    "prettier": "2.8.6",
    "rimraf": "^6.1.3",
    "sass": "1.60.0",
    "typescript": "^5.9.3"
  }
}