{
  "name": "ghis",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve": "ng serve --open",
    "clean": "rimraf dist"
  },
  "description": "Elegant resume and CV theme with Bootstrap 5.",
  "keywords": [
    "css",
    "sass",
    "html",
    "responsive",
    "theme",
    "template"
  ],
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.11",
    "autoprefixer": "10.4.14",
    "browser-sync": "^3.0.4",
    "chokidar": "^3.5.3",
    "concurrently": "6.3.0",
    "esbuild": "^0.27.0",
    "live-server": "^1.2.0",
    "postcss": "^8.5.6",
    "prettier": "2.8.6",
    "pug": "^3.0.3",
    "rimraf": "^6.1.3",
    "sass": "1.60.0",
    "shelljs": "0.8.5",
    "typescript": "^5.9.3",
    "upath": "2.0.1"
  }
}
